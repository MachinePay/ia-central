      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT u.id AS dono_id, nucleo.cfg('gabriel_nome', split_part(u.nome, ' ', 1)) AS dono_nome, nucleo.estilo_dono(u.id) AS estilo,\n  (SELECT coalesce(string_agg('- ' || coalesce(k.titulo, '') || ': ' || left(k.conteudo, 200), E'\\n'), '(vazia)')\n     FROM (SELECT * FROM nucleo.conhecimento WHERE usuario_id = u.id AND aprovado\n            ORDER BY criado_em DESC LIMIT 60) k) AS memoria\nFROM nucleo.usuarios u WHERE u.papel = 'admin' AND u.ativo ORDER BY u.id LIMIT 1",
        "options": {}
