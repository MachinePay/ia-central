      "name": "Preparar audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// devolve o audio do webhook com nome/extensao que a OpenAI reconhece\nconst recebido = $('Webhook').first().binary || {};\nconst bin = { ...(recebido.data || recebido.audio || Object.values(recebido)[0]) };\nif (!bin.mimeType) throw new Error('Nenhum audio recebido');\nconst mime = (bin.mimeType || 'audio/webm').split(';')[0];\nconst ext = { 'audio/webm': 'webm', 'audio/mp4': 'mp4', 'audio/x-m4a': 'm4a', 'audio/mpeg': 'mp3',\n  'audio/ogg': 'ogg', 'audio/wav': 'wav', 'audio/aac': 'm4a' }[mime] || 'webm';\nbin.fileName = 'fala.' + ext; bin.fileExtension = ext; bin.mimeType = mime;\nreturn [{ json: $input.first().json, binary: { audio: bin } }];"
      }
    },
