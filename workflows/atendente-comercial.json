        "toolDescription": "registrar_interesse: registra/atualiza o cliente como lead: nome, empresa e o que ele quer.",
        "operation": "executeQuery",
        "query": "UPDATE nucleo.clientes SET nome = coalesce(nullif($2,''), nome), empresa = coalesce(nullif($3,''), empresa),\n  interesse = coalesce(nullif($4,''), interesse), etapa = CASE WHEN etapa = 'novo' THEN 'lead' ELSE etapa END\nWHERE id = $1::int RETURNING nome, empresa, interesse, etapa",
