          "queryReplacement": "={{ [$('Quando chamado').first().json.cliente_id, $fromAI('nome', 'nome do cliente; vazio se nao souber', 'string'), $fromAI('empresa', 'empresa dele; vazio se nao souber', 'string'), $fromAI('interesse', 'o que ele quer comprar/saber', 'string')] }}"
