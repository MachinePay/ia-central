      "id": "c0000000-0000-4000-8000-000000000029",
      "name": "Registrar chamado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH c AS (\n  INSERT INTO nucleo.chamados (cliente_id, area, titulo, descricao, prioridade)\n  VALUES ($1::int, CASE WHEN $2 IN ('suporte','comercial','sistemico','humano') THEN $2 ELSE 'suporte' END,\n          coalesce(nullif($3,''), 'Chamado'), $4,\n          CASE WHEN $5 IN ('baixa','normal','alta') THEN $5 ELSE 'normal' END)\n  RETURNING *)\nSELECT c.id, c.area, c.titulo, c.prioridade, cl.nome, cl.whatsapp,\n  (SELECT jsonb_agg(id) FROM nucleo.usuarios WHERE papel = 'admin' AND ativo) AS admins\nFROM c LEFT JOIN nucleo.clientes cl ON cl.id = c.cliente_id",
        "options": {
          "queryReplacement": "={{ [$json.cliente_id, $json.area || 'suporte', $json.titulo || '', $json.descricao || '', $json.prioridade || 'normal'] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "pgNucleo01",
          "name": "Postgres Nucleo"
        }
      }
    },
    {
      "id": "c0000000-0000-4000-8000-000000000030",
      "name": "Avisar admins",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c = $input.first().json;\nconst teste = String(c.whatsapp || '').startsWith('teste');\nconst msg = `📋 Chamado #${c.id} (${c.area}${c.prioridade === 'alta' ? ', ALTA' : ''})\\n${c.titulo}\\n`\n  + `Cliente: ${c.nome || 'sem nome'}${c.whatsapp && !teste ? ' +' + c.whatsapp : ''}\\nVeja no painel → Atendimento.`;\nreturn (teste ? [] : (c.admins || [])).map(id => ({ json: { usuario_id: id, contato: '', mensagem: msg } }))\n  .concat([{ json: { _resultado: `Chamado #${c.id} aberto (${c.area}). A equipe foi avisada.` } }]);"
      }
    },
    {
      "id": "c0000000-0000-4000-8000-000000000031",
      "name": "So avisos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().filter(i => i.json.usuario_id);"
      },
      "alwaysOutputData": true
    },
    {
