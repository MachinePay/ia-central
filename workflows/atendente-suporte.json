      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "buscar_base: procura na base de conhecimento da empresa (suporte + geral). Traz primeiro o que combina com as palavras.",
        "operation": "executeQuery",
        "query": "SELECT titulo, conteudo, relevante FROM nucleo.buscar_base('suporte', $1)",
        "options": {
          "queryReplacement": "={{ [$fromAI('busca', 'palavras-chave simples, ex: preco plano mensal', 'string')] }}"
        }
      },
