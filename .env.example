# Copie para .env e preencha. O .env NUNCA vai para o git.
NODE_ENV=development
PORT=3000
# endereco publico da API (webhooks)
PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgresql://ia:troque@localhost:5433/ia_central
# o sistema novo vive no schema "app"; "nucleo" e o legado (so leitura)
DB_SCHEMA=app
REDIS_URL=redis://localhost:6379

# WhatsApp (Evolution API) - as instancias ja conectadas continuam; so o webhook passa a apontar para ca
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_TOKEN=gere-um-segredo-longo
# papel de cada instancia: ATENDIMENTO (Leo roteia para Joao/Clara/Gabriel), GABRIEL (seu numero pessoal) ou OFF
WA_INSTANCES=joao:ATENDIMENTO,suporte:ATENDIMENTO,gabriel:GABRIEL,nucleo:OFF

# Gmail (opcional: deixe GMAIL_ACCOUNT vazio para desligar)
GMAIL_ACCOUNT=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_PUBSUB_TOPIC=projects/SEU-PROJETO/topics/gmail-inbox
GMAIL_PUSH_AUDIENCE=                      # audience do token OIDC da assinatura push (normalmente PUBLIC_URL/webhooks/gmail)
GMAIL_PUSH_SERVICE_ACCOUNT=               # e-mail da service account da assinatura push

# Modelos: "provedor:modelo" (openai ou anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_ROUTER_MODEL=openai:gpt-5-mini
LLM_AGENT_MODEL=openai:gpt-5
LLM_SMALL_MODEL=openai:gpt-5-mini
LLM_SUMMARY_MODEL=openai:gpt-5-mini
LLM_VISION_MODEL=openai:gpt-5-mini
# usado se o principal falhar (precisa da ANTHROPIC_API_KEY)
LLM_FALLBACK_MODEL=anthropic:claude-sonnet-5-5
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
EMBEDDING_MODEL=text-embedding-3-small

# Gabriel real
# recebe aprovacoes e alertas
GABRIEL_PERSONAL_PHONE=5511999999999
# instancia que manda as aprovacoes para o Gabriel
APPROVAL_INSTANCE=joao

# Politica
MAX_AUTO_DISCOUNT_PERCENT=5
DAILY_COST_LIMIT_USD=5
BUSINESS_HOURS="seg-sex 08:00-18:00"
TIMEZONE=America/Sao_Paulo

# Envio: draft = nada sai sozinho (modo sombra). auto = envia. AUTO_SEND_AGENTS libera por agente no modo draft.
SEND_MODE=draft
AUTO_SEND_AGENTS=
# true: manda cada rascunho do WhatsApp para o Gabriel ver
SHADOW_NOTIFY=false

# Painel de filas (Bull Board) em /admin/queues
ADMIN_USER=admin
ADMIN_PASSWORD=troque
