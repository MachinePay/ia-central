# Copie para .env e preencha. O .env NUNCA vai para o git.
POSTGRES_USER=ia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=ia_central

# Chave que criptografa as credenciais salvas no n8n.
# Gere uma vez e NAO perca (sem ela as credenciais salvas ficam ilegiveis).
N8N_ENCRYPTION_KEY=gere-uma-chave-longa-aleatoria

# Endereco publico do n8n (local: http://localhost:5678/ ; no Render: https://seu-app.onrender.com/)
WEBHOOK_URL=http://localhost:5678/

# Modelos de IA (preencha o que for usar)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Alertas via Telegram (crie um bot com o @BotFather)
TELEGRAM_BOT_TOKEN=

# Admin maximo do painel (criado por scripts/criar-admin.sh)
ADMIN_NOME=Admin
ADMIN_LOGIN=admin
ADMIN_SENHA=troque-esta-senha

# WhatsApp (Evolution API)
EVOLUTION_API_KEY=gere-uma-chave-longa
EVOLUTION_INSTANCIA=nucleo
# segredo no endereco do webhook (impede alguem de fingir ser o WhatsApp)
WHATSAPP_WEBHOOK_SEGREDO=gere-um-segredo

# Monitor de plataformas (opcional; deixe vazio para nao usar)
# Render: Account Settings -> API Keys | Vercel: Account Settings -> Tokens
RENDER_API_KEY=
VERCEL_TOKEN=
# so se os projetos estiverem num time da Vercel (Settings do time -> Team ID)
VERCEL_TEAM_ID=
